# ---------------------------------------------------------------------------
# You do NOT need a .env file for local development.
#
# `npm run dev` (shopify app dev) injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET,
# SHOPIFY_APP_URL and SCOPES into the process for you, and rewrites
# application_url in shopify.app.toml each run as the tunnel URL rotates.
#
# Copy this file to .env only when you need to run the server WITHOUT the
# Shopify CLI (for example `react-router dev`, a Docker build, or production):
#
#   cp .env.example .env
#
# Values come from `npm run env -- show`, or the app's page in the Partner
# Dashboard. Never commit the filled-in .env — it is gitignored.
# ---------------------------------------------------------------------------

# Client ID from shopify.app.toml / Partner Dashboard.
SHOPIFY_API_KEY=

# Client secret. Secret — do not share or commit.
SHOPIFY_API_SECRET=

# Public HTTPS URL of this app, no trailing slash. Used for OAuth.
# Under `shopify app dev` this is the rotating tunnel URL and is set for you.
# Referral links do NOT depend on it — they are built from the shop domain as
# https://<shop>/apps/referral/r/<code>, so they survive the tunnel rotating.
SHOPIFY_APP_URL=

# Comma-separated, must match access_scopes.scopes in shopify.app.toml.
SCOPES=write_products,write_metaobjects,write_metaobject_definitions,write_app_proxy

# Optional: only for stores on a custom domain the CLI does not know about.
# SHOP_CUSTOM_DOMAIN=

# Optional: Prisma reads prisma/schema.prisma's hardcoded sqlite path by default,
# so this is only needed if you switch the datasource to env("DATABASE_URL").
# DATABASE_URL=file:./dev.sqlite
